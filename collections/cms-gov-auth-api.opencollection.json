{
  "opencollection": "1.0.0",
  "info": {
    "name": "CMS AB2D Articles Auth API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Beneficiary User Info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ab2d.cms.gov/api/v2/userinfo"
          },
          "docs": "OpenID Connect userinfo endpoint returning beneficiary identity claims."
        },
        {
          "info": {
            "name": "Create Client Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ab2d.cms.gov/api/v2/Token"
          },
          "docs": "Create a long-lived client token for the registered organization."
        }
      ]
    }
  ],
  "bundled": true
}